# Copy this file to `.env` and fill in NEW (rotated) keys.
# `.env` is gitignored. NEVER commit real keys.

# ─── Mistral ─────────────────────────────────────────────────────────────
# Get a new key: https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=devstral-2512
MISTRAL_EMBED_MODEL=codestral-embed

# ─── Azure DevOps ────────────────────────────────────────────────────────
# Get a new PAT: https://dev.azure.com/<org>/_usersSettings/tokens
# Required scopes for the PAT:
#   - Code: Read & write
#   - Pull Request Threads: Read & write
ABID_ADO_PAT=

# Your ADO org / project / repo
ADO_ORG=gharoffice
ADO_PROJECT=
ADO_REPO=

# ─── Local-only flags ────────────────────────────────────────────────────
# Use fake embeddings (no Mistral embedding cost) — set to 0 to use real ones
ABID_FAKE_EMBED=1

# Where prompt templates live (default = ./prompts)
ABID_PROMPTS_DIR=./prompts

# Log level
LOG_LEVEL=info
