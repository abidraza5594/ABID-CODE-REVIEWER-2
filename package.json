{
  "name": "abid-review",
  "private": true,
  "version": "0.1.0",
  "description": "Runtime-aware AI code review for Azure DevOps Angular repos",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "dev:gateway": "pnpm --filter @abid/webhook-gateway dev",
    "dev:orchestrator": "pnpm --filter @abid/orchestrator dev",
    "dev:runner": "pnpm --filter @abid/runtime-runner dev"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "tsx": "^4.7.0"
  }
}
